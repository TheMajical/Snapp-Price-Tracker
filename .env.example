# -------------------------------------------------------------
# Snapp Price Tracker - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# -------------------------------------------------------------

# Optional: Password to protect the web dashboard with HTTP Basic Auth
# If set, any visitor will be prompted for this password (username can be anything)
APP_PASSWORD=

# Optional: Data storage directory for SQLite database and config
# Default: ./data (or /app/data inside Docker container)
DATA_DIR=./data
